{
  "manifest_version": 3,
  "name": "Cockpit Space feedback",
  "version": "1.0.0",
  "description": "Annotate a live page and send durable feedback to Cockpit Space.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Annotate page",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": { "description": "Open Cockpit feedback" },
    "open-annotation-toolbar": { "suggested_key": { "default": "Ctrl+Shift+9" }, "description": "Open the annotation toolbar" }
  },
  "key": "",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
