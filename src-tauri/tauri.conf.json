{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cockpit",
  "version": "0.1.0",
  "identifier": "dev.cockpit.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cockpit",
        "width": 1280,
        "height": 800,
        "decorations": true,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
