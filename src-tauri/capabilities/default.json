{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability for the Cockpit main window",
  "windows": ["main"],
  "permissions": [
    "allow-cockpit-status",
    "allow-cockpit-sessions",
    "allow-cockpit-session-snapshot",
    "allow-cockpit-focus",
    "allow-cockpit-mutate",
    "allow-cockpit-session-subscribe",
    "allow-cockpit-terminal-open",
    "allow-cockpit-terminal-command",
    "allow-cockpit-stream-cancel"
  ]
}
