{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability for the Cockpit main window",
  "windows": ["main"],
  "permissions": [
    "allow-cockpit-status",
    "allow-cockpit-sessions",
    "allow-cockpit-project-configuration",
    "allow-cockpit-repositories",
    "allow-cockpit-workspace-plan",
    "allow-cockpit-workspace-start",
    "allow-cockpit-workspace-operation",
    "allow-cockpit-workspace-resume",
    "allow-cockpit-workspace-cancel",
    "allow-cockpit-workspace-reconcile",
    "allow-cockpit-workspace-teardown-preview",
    "allow-cockpit-workspace-teardown-execute",
    "allow-cockpit-workspace-teardown-recoveries",
    "allow-cockpit-pane-presentation",
    "allow-cockpit-context-directory",
    "allow-cockpit-context-document",
    "allow-cockpit-context-open",
    "allow-cockpit-context-search",
    "allow-cockpit-context-snapshot",
    "allow-cockpit-context-invalidate",
    "allow-cockpit-comments-list",
    "allow-cockpit-comments-batch",
    "allow-cockpit-comments-upsert",
    "allow-cockpit-comments-remove",
    "allow-cockpit-comments-attach",
    "allow-cockpit-comments-preview",
    "allow-cockpit-comments-paste-prepare",
    "allow-cockpit-comments-paste-send",
    "allow-cockpit-comments-paste-mark-pasted",
    "allow-cockpit-session-snapshot",
    "allow-cockpit-focus",
    "allow-cockpit-mutate",
    "allow-cockpit-session-subscribe",
    "allow-cockpit-terminal-open",
    "allow-cockpit-terminal-command",
    "allow-cockpit-stream-cancel"
  ]
}
