    "allow-cockpit-clipboard-write",
    "allow-cockpit-stream-cancel",
    "allow-cockpit-library-space-list",
    "allow-cockpit-notes-execute",
    "allow-cockpit-library-space-add",
    "allow-cockpit-library-space-repositories",
    "allow-cockpit-library-space-remove",
    "allow-cockpit-provider-credentials",
    "allow-cockpit-provider-credential-set",
    "allow-cockpit-provider-credential-clear",
    "allow-cockpit-context-media",
    "allow-cockpit-library-listing",
    "allow-cockpit-library-resolve",
    "allow-cockpit-library-confluence-spaces",
    "allow-cockpit-library-add",
    "allow-cockpit-library-attachments",
    "allow-cockpit-library-refresh",
    "allow-cockpit-library-operation",
    "allow-cockpit-library-operation-cancel",
    "allow-cockpit-library-replace",
    "allow-cockpit-library-remove",
    "allow-cockpit-library-directory",
    "allow-cockpit-library-file-index",
    "allow-cockpit-library-document",
    "allow-cockpit-library-media",
    "allow-cockpit-space-git-status",
    "allow-cockpit-space-service-status",
    "allow-cockpit-space-cpu-status",
    "allow-cockpit-space-tags",
    "allow-cockpit-space-tag-change",
    "allow-cockpit-agent-attention",
    "allow-cockpit-agent-attention-change",
    "allow-cockpit-quick-ask-availability",
    "allow-cockpit-quick-ask",
    "allow-cockpit-space-git-action",
    "allow-cockpit-browser-action",
    "allow-cockpit-browser-feedback",
    "allow-cockpit-browser-feedback-ack",
    "allow-cockpit-browser-feedback-image",
    "allow-cockpit-browser-feedback-send",
    "allow-cockpit-browser-cleanup-status",
    "allow-cockpit-browser-cleanup-retry",
    "allow-cockpit-browser-view-open",
    "allow-cockpit-browser-view-command",
    "allow-cockpit-browser-view-subscribe",
    "allow-cockpit-browser-view-release",
    "allow-cockpit-browser-draft-recovery",
    "allow-cockpit-power-status",
    "allow-cockpit-power-set-stay-awake",
    "allow-cockpit-power-screen-off",
