    "allow-cockpit-context-document",
    "allow-cockpit-context-search",
    "allow-cockpit-context-invalidate",
    "allow-cockpit-review-snapshot",
    "allow-cockpit-review-file",
    "allow-cockpit-comments-list",
    "allow-cockpit-comments-batch",
    "allow-cockpit-comments-upsert",
    "allow-cockpit-comments-remove",
    "allow-cockpit-comments-attach",
    "allow-cockpit-comments-discard",
    "allow-cockpit-comments-preview",
    "allow-cockpit-comments-paste-prepare",
    "allow-cockpit-comments-paste-send",
    "allow-cockpit-comments-paste-mark-pasted",
    "allow-cockpit-session-snapshot",
    "allow-cockpit-focus",
