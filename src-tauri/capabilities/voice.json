{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "voice",
  "description": "Narrow IPC access for the isolated voice webview",
  "webviews": ["voice-child"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-cockpit-voice-view-context",
    "allow-cockpit-voice-view-close",
    "allow-cockpit-voice-connect",
    "allow-cockpit-voice-events",
    "allow-cockpit-voice-control",
    "allow-orchestration-liaison-lookup",
    "allow-cockpit-repositories",
    "allow-cockpit-sessions",
    "allow-cockpit-session-snapshot"
  ]
}
