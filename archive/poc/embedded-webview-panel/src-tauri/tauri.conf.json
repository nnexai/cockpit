{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Embedded WebView Panel POC",
  "version": "0.1.0",
  "identifier": "dev.cockpit.embedded-webview-panel-poc",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Embedded WebView Panel POC",
        "width": 1320,
        "height": 860,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; frame-src 'self' http: https:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
