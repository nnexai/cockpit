{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CEF OSR Panel POC",
  "version": "0.1.0",
  "identifier": "dev.cockpit.cef-osr-panel-poc",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "CEF OSR/CDP Panel POC",
      "width": 1320,
      "height": 860,
      "minWidth": 820,
      "minHeight": 620,
      "resizable": true
    }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": { "active": false }
}
